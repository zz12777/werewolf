// Firestore 安全規則（連線房間、村莊用）。
// 這份檔案只是放在 repo 裡留存、方便對照，網站不會自動套用：改完要到 Firebase 主控台
// → Firestore Database → 規則（Rules）分頁，整份貼上、按「發布」才會生效。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomCode} {
      // 是不是這個房間的成員：players 子集合底下有沒有一份文件的 id 剛好是我的 uid。
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));
      }
      // 這個房間是不是已經可以清掉了：房間文件已經不在（剩下沒刪乾淨的子集合），或是
      // 建立時間（createdAt）超過一天。網頁會定期把超過一天的房間連同子集合整個刪掉
      // （見 js/room/cleanup.js），清的人不一定是那個房間的成員，所以另外開放這個條件。
      function roomExpired() {
        let roomPath = /databases/$(database)/documents/rooms/$(roomCode);
        return request.auth != null && (
          !exists(roomPath) ||
          get(roomPath).data.get('createdAt', request.time) < request.time - duration.value(1, 'd')
        );
      }

      // 建立新房間：任何登入的人都可以開房——這時候房間裡還沒有任何 players 文件，
      // isMember() 一定判斷不出來，所以「建立房間」本身不能卡在 isMember()。
      allow create: if request.auth != null;
      // 讀取房間基本資料（狀態／板子／人數）：加入房間前（players/{uid} 還沒寫入）
      // 就需要讀這份資料來檢查房號、板子、是不是已經額滿，所以維持「登入就能讀」；
      // 但「更新」房間狀態（phase／currentStep／投票結果……）必須已經是成員才行。
      allow read: if request.auth != null;
      allow update: if isMember();
      // 刪除房間：成員可以刪（法官助手的手機連線配置用完就刪），超過一天的房間任何登入的
      // 人都可以刪（自動清理）。
      allow delete: if isMember() || roomExpired();

      match /players/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if isMember();
        allow delete: if isMember() || roomExpired();
      }

      // 以下都是「加入房間之後」才會用到的子集合，一律要求已經是這個房間的成員才能
      // 讀，關掉「陌生人掃房號就能看到所有人身分」這個洞。
      match /secrets/{uid} {
        allow read: if isMember();
        // 寫入發生在「隨機分配身分」那一刻，是房主一次寫入全部座位的身分（不是各自
        // 寫自己那份），所以用 isMember() 而不是 auth.uid==uid，跟這個 app 其餘
        // 「房間成員互相信任、只防外人」的既有設計一致。
        allow write: if isMember();
      }
      match /seerChecks/{uid} {
        allow read: if isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /mediumChecks/{uid} {
        allow read: if isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /witchActs/{uid} {
        allow read: if isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /demonhunterActs/{uid} {
        allow read: if isMember();
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      match /nightLog/{night} {
        allow read, write: if isMember();
      }
      match /chat/{msgId} {
        allow read, write: if isMember();
      }
      match /dayLog/{day} {
        allow read, write: if isMember();
      }
      match /votes/{voteDoc} {
        allow read: if isMember();
        // 票的文件 id 格式是「{自己的uid}_{round}」（見 js/room/day.js），只准
        // 寫開頭是自己 uid 的那份，不能竄改別人投的票。
        allow write: if request.auth != null && voteDoc.matches(request.auth.uid + '_.*');
      }
      match /mechwolfChecks/{checkDoc} {
        allow read: if isMember();
        // 文件 id 格式是「{自己的uid}_{night}」（見 js/room/roles-special.js 機械狼查驗）。
        allow write: if request.auth != null && checkDoc.matches(request.auth.uid + '_.*');
      }

      // 自動清理：超過一天的房間，所有子集合（不管上面有沒有列到）都可以列出來、刪掉。
      // 遊戲早就結束了，這時候讀得到身分也沒關係。
      match /{subCollection}/{docId} {
        allow read, delete: if roomExpired();
      }
    }

    // ══════════ 村莊（公開版，js/village.js）══════════
    // 只有用 Google 帳號登入的人可以建立／加入村莊（連線房間用的匿名登入不行）。
    function googleUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function villagePath(vid) { return /databases/$(database)/documents/villages/$(vid); }
    function isVillageMember(vid) {
      return request.auth != null && exists(/databases/$(database)/documents/villages/$(vid)/members/$(request.auth.uid));
    }
    function isVillageOwner(vid) {
      return request.auth != null && exists(villagePath(vid)) && get(villagePath(vid)).data.ownerUid == request.auth.uid;
    }
    function shortText(v, max) { return v is string && v.size() <= max; }

    match /villages/{vid} {
      // 只有成員讀得到村莊（名稱、玩家名單、邀請碼）。
      allow read: if isVillageMember(vid);
      // 建立村莊：自己當村長。
      allow create: if googleUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name','ownerUid','ownerName','inviteCode','roster','createdAt'])
        && shortText(request.resource.data.name, 40)
        && request.resource.data.roster is list;
      // 村長可以改村莊；一般成員只能改玩家名單。
      allow update: if (isVillageOwner(vid)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.keys().hasOnly(['name','ownerUid','ownerName','inviteCode','roster','createdAt','updatedAt']))
        || (isVillageMember(vid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roster','updatedAt'])
          && request.resource.data.roster is list && request.resource.data.roster.size() <= 500);
      allow delete: if isVillageOwner(vid);

      match /members/{uid} {
        allow read: if isVillageMember(vid);
        // 加入村莊：只能把自己加進去。村長建立村莊時把自己加成 owner；其他人要帶正確的邀請碼，
        // 而且只能是 member。
        allow create: if googleUser() && uid == request.auth.uid
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','role','joinedAt','code'])
          && shortText(request.resource.data.name, 40)
          && ((request.resource.data.role == 'owner' && isVillageOwner(vid))
            || (request.resource.data.role == 'member'
              && request.resource.data.code is string
              && get(/databases/$(database)/documents/invites/$(request.resource.data.code)).data.vid == vid));
        allow update: if false;
        // 自己離開，或村長移除成員。
        allow delete: if (request.auth != null && uid == request.auth.uid) || isVillageOwner(vid);
      }

      match /games/{gid} {
        allow read: if isVillageMember(vid);
        // 所有成員都可以把場次存進村莊（記錄的人一定是自己）。
        allow create: if isVillageMember(vid)
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.keys().hasOnly(['id','date','time','board','resultText','winner','players','log','recordedBy','recordedByName','createdAt'])
          && request.resource.data.winner in ['good','evil','third']
          && request.resource.data.players is list && request.resource.data.players.size() <= 20
          && shortText(request.resource.data.log, 30000)
          && shortText(request.resource.data.board, 60);
        // 刪除、修改紀錄只有村長可以。
        allow update, delete: if isVillageOwner(vid);
      }
    }

    // 邀請碼 → 村莊。知道邀請碼的人才查得到（不能列出全部邀請碼）。
    match /invites/{code} {
      allow get: if googleUser();
      allow list: if false;
      allow create: if googleUser()
        && request.resource.data.keys().hasOnly(['vid','name'])
        && isVillageOwner(request.resource.data.vid);
      allow delete: if isVillageOwner(resource.data.vid);
      allow update: if false;
    }

    // 我加入了哪些村莊：只有自己讀寫。
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
